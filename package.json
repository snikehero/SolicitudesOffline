{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "postbuild": "node scripts/publish-asset-manifest.mjs",
    "android:sync": "cap sync android",
    "preandroid:sync": "npm run build",
    "android:open": "cap open android",
    "android:apk": "node scripts/build-android-apk.mjs",
    "preandroid:apk": "npm run android:sync",
    "android:release": "node scripts/build-android-apk.mjs --release",
    "preandroid:release": "npm run android:sync",
    "start": "node scripts/local-https-server.mjs",
    "prestart": "npm run build",
    "local:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-https.ps1",
    "lint": "oxlint app src",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@capacitor/android": "8.4.3",
    "@capacitor/core": "8.4.3",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "dexie": "^4.4.5",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "jszip": "^3.10.2",
    "lucide-react": "1.31.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-pdf": "^10.5.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "signature_pad": "^5.1.4",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
